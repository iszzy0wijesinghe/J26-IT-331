# all optional, defaults are in app/config.py
# paths are relative to the repo root
C1_MODEL_PATH=models/c1/c1_xgboost_v1.json
C1_META_PATH=models/c1/c1_xgboost_v1_meta.json
C1_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# only used when the meta file has no "classes" list, order = training encoding 0,1,2
C1_CLASS_ORDER=CLEAN,ANOMALY,VALID_EVENT
C1_MAX_BATCH=1000
C1_HISTORY_SIZE=200
