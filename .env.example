GEONEX_ENV=development

# PostgreSQL Docker configuration
POSTGRES_DB=geonex
POSTGRES_USER=geonex_app
POSTGRES_PASSWORD=YOUR_PRIVATE_PASSWORD
POSTGRES_PORT=5433

# GeoNex Python configuration
GEONEX_ENV=development
GEONEX_DB_HOST=127.0.0.1
GEONEX_DB_PORT=5433
GEONEX_DB_NAME=geonex
GEONEX_DB_USER=geonex_app
GEONEX_DB_PASSWORD=YOUR_PRIVATE_PASSWORD